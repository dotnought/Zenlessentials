{
  "name": "zenlessentials",
  "version": "1.0.0",
  "description": "A Zenless Zone Zero story tracker, game database, and team builder.",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "validate:data": "tsx scripts/validate-data.ts",
    "build": "npm run check && npm run validate:data && npm run validate:database && vite build",
    "preview": "vite preview",
    "test": "tsx --test tests/unit.test.ts",
    "test:e2e": "playwright test",
    "validate:database": "tsx scripts/database/validate.ts",
    "update:database": "tsx scripts/database/link-stories.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dotnought/Zenlessentials.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/dotnought/Zenlessentials/issues"
  },
  "homepage": "https://github.com/dotnought/Zenlessentials#readme",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@supabase/supabase-js": "^2.119.1",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  },
  "private": true,
  "engines": {
    "node": "^22.12.0 || >=24"
  }
}
